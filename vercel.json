{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/for-businesses.html",
      "destination": "/for-businesses",
      "permanent": true
    },
    {
      "source": "/for-creators.html",
      "destination": "/for-creators",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/:path*.html/",
      "destination": "/:path*.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/for-businesses",
      "destination": "/for-businesses.html"
    },
    {
      "source": "/for-creators",
      "destination": "/for-creators.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}
