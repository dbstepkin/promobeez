{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/for-businesses.html",
      "destination": "/for-businesses",
      "permanent": true
    },
    {
      "source": "/for-creators.html",
      "destination": "/for-creators",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/why-local-creators-beat-famous-influencers",
      "destination": "/blog/how-to-choose-a-local-creator",
      "permanent": true
    },
    {
      "source": "/blog/why-local-creators-beat-famous-influencers.html",
      "destination": "/blog/how-to-choose-a-local-creator",
      "permanent": true
    },
    {
      "source": "/blog/why-audiences-trust-small-creators-more-than-brands.html",
      "destination": "/blog/why-audiences-trust-small-creators-more-than-brands",
      "permanent": true
    },
    {
      "source": "/blog/how-to-choose-a-local-creator.html",
      "destination": "/blog/how-to-choose-a-local-creator",
      "permanent": true
    },
    {
      "source": "/about/andrey-shepelev.html",
      "destination": "/about/andrey-shepelev",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/:path*.html/",
      "destination": "/:path*.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/for-businesses",
      "destination": "/for-businesses.html"
    },
    {
      "source": "/for-creators",
      "destination": "/for-creators.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/how-to-choose-a-local-creator",
      "destination": "/blog/how-to-choose-a-local-creator.html"
    },
    {
      "source": "/blog/why-audiences-trust-small-creators-more-than-brands",
      "destination": "/blog/why-audiences-trust-small-creators-more-than-brands.html"
    },
    {
      "source": "/about/andrey-shepelev",
      "destination": "/about/andrey-shepelev.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}
