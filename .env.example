# Vercel / local env for Promobeez Landing

# Awards form (/promobeez-smm-awards → api/awards-check.js)
# Both secrets are required (fail 503 if missing). No defaults.
AWARDS_WEBHOOK_URL=https://db.promobeez.com/functions/v1/awards-rank-check
# Must match Supabase / infra AWARDS_WEBHOOK_TOKEN (Bearer).
AWARDS_WEBHOOK_TOKEN=
# HMAC for form tokens (ts.nonce.sig). Use a long random string; never commit the real value.
AWARDS_FORM_SECRET=

# Investor page (/investments): password gate in middleware.js + live data / visit log in api/investor-*.js
INVESTOR_PASSWORD=
# Admin key for the private visitors report: open /investments/visitors?key=<INVESTOR_ADMIN_KEY> once.
INVESTOR_ADMIN_KEY=
# Read live metrics and write investor.* events to product_events (server-side only, never sent to the browser).
SUPABASE_URL=https://db.promobeez.com
SUPABASE_SERVICE_ROLE_KEY=
# Paying-venue count. Use a restricted key with read access to Charges and Customers only.
STRIPE_SECRET_KEY=
