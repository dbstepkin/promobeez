# Vercel / local env for Promobeez Landing

# Awards form (/promobeez-smm-awards → api/awards-check.js)
# Without AWARDS_WEBHOOK_URL the form returns 503 not_configured.
AWARDS_WEBHOOK_URL=https://db.promobeez.com/functions/v1/awards-rank-check
# Must match Supabase secret AWARDS_WEBHOOK_TOKEN (Bearer).
AWARDS_WEBHOOK_TOKEN=
# HMAC for form anti-bot tokens (set a long random string in production)
AWARDS_FORM_SECRET=
