# Vercel / local env for Promobeez Landing

# Awards form (/promobeez-smm-awards → api/awards-check.js)
# Both secrets are required (fail 503 if missing). No defaults.
AWARDS_WEBHOOK_URL=https://db.promobeez.com/functions/v1/awards-rank-check
# Must match Supabase / infra AWARDS_WEBHOOK_TOKEN (Bearer).
AWARDS_WEBHOOK_TOKEN=
# HMAC for form tokens (ts.nonce.sig). Use a long random string; never commit the real value.
AWARDS_FORM_SECRET=
